<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  LifePulse - Emergency Blood Alert System
  File: backend/pom.xml
  Description: Maven Project Object Model defining project metadata,
               Java 21 compiler settings, and Spring Boot dependencies.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot Starter Parent provides sensible defaults for dependency versions and plugins -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- Project Coordinates -->
    <groupId>com.bloodbond</groupId>
    <artifactId>blood-alert-system</artifactId>
    <version>1.0.0</version>
    <name>blood-alert-system</name>
    <description>Emergency Blood Alert &amp; Donor Coordination System REST Backend</description>

    <properties>
        <!-- Compiles targeting Java 21 LTS -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 1. Spring Boot Starter Web: Includes Spring MVC, REST controllers, and embedded Apache Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 2. Spring Boot Starter Data JPA: Simplifies database access with Hibernate & Spring Repositories -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 3. Jakarta Bean Validation: Validates incoming REST request DTOs (@NotBlank, @Size, @Pattern) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 4. MySQL JDBC Driver: Connects Spring Boot to MySQL Database -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 5. H2 In-Memory Database: Serves as a zero-setup fallback during development/testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 6. Spring Boot Starter Test: JUnit 5 & Mockito for verifying API controllers and services -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin: Packages application into an executable JAR file -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
