# ===================================================================
# LifePulse - Emergency Blood Alert System
# File: .env.example
# Description: Environment variable template for production deployment
#              (Railway, Render, Azure, Docker Compose)
# ===================================================================

# -------------------------------------------------------------------
# Server Port (Auto-assigned by Railway / Render via $PORT)
# -------------------------------------------------------------------
PORT=8080

# -------------------------------------------------------------------
# Active Spring Profile (e.g. 'prod' for production, 'h2' for zero-db local dev)
# -------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# -------------------------------------------------------------------
# MySQL Database Connection Settings
# For Railway / Aiven / TiDB Cloud / Azure Database for MySQL:
# Example: jdbc:mysql://hopper.proxy.rlwy.net:49123/railway?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
# -------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/blood_alert_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver

# -------------------------------------------------------------------
# Hibernate / JPA Settings
# 'update' automatically ensures tables and schema exist without data loss.
# -------------------------------------------------------------------
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# -------------------------------------------------------------------
# CORS Security Lockdown
# Restricts browser cross-origin requests to trusted production origins.
# Format: comma-separated list of allowed origins or origin patterns (*.domain.com)
# Example: https://lifepulse.vercel.app,https://*.vercel.app,http://localhost:3000
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://*.vercel.app,https://*.netlify.app,https://*.up.railway.app

# -------------------------------------------------------------------
# Frontend Runtime API Base URL
# Read by Vercel / Netlify frontend or set via localStorage in the browser
# Example: https://lifepulse-backend-production.up.railway.app/api
# -------------------------------------------------------------------
LIFEPULSE_API_URL=http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api
